---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Career from '../components/Career.astro';
import Skills from '../components/Skills.astro';
import Work from '../components/Work.astro';
import Writing from '../components/Writing.astro';
import Videos from '../components/Videos.astro';
import Recognition from '../components/Recognition.astro';
import Contact from '../components/Contact.astro';
import CompareToggle from '../components/CompareToggle.astro';
---

<Layout>
    <Nav />
    <main id="main">
        <Hero />
        <About />
        <Career />
        <Work />
        <Skills />
        <Writing />
        <Videos />
        <Recognition />
        <Contact />
    </main>
    <CompareToggle />
</Layout>
