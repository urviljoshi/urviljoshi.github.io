---
import { videos, channel, fmtDate, compactViews, cleanTitle } from '../data/content';
---

<section class="section videos" id="videos" data-section="videos">
    <div class="wrap">
        <header class="videos-head">
            <div class="section-head">
                <p class="label" data-reveal>FluxStack on YouTube</p>
                <h2 class="section-title" data-split>Ideas, taken apart <em>on camera</em>.</h2>
            </div>
            <div class="rail-controls" data-reveal>
                <button class="rail-btn" type="button" data-rail-prev aria-label="Previous videos">&larr;</button>
                <button class="rail-btn" type="button" data-rail-next aria-label="Next videos">&rarr;</button>
            </div>
        </header>
    </div>

    <div class="rail" data-rail tabindex="0" aria-label="Recent videos">
        {videos.map((v) => (
            <a href={v.url} target="_blank" rel="noopener" class="vid" data-stagger-item>
                <span class="vid-thumb" data-tilt data-tilt-max="8">
                    <img src={v.thumbnail} alt="" width="480" height="360" loading="lazy" draggable="false" />
                    {v.short && <span class="vid-badge label">Short</span>}
                    <span class="vid-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
                    </span>
                </span>
                <span class="vid-title">{cleanTitle(v.title)}</span>
                <span class="vid-meta mono">
                    <span>{fmtDate(v.date)}</span>
                    {v.views > 0 && <span>{compactViews(v.views)} views</span>}
                </span>
            </a>
        ))}
        <a href={channel.url} target="_blank" rel="noopener" class="vid vid-more">
            <span class="vid-more-inner card orbit" data-spotlight>
                <span class="label">Channel</span>
                <span class="vid-more-title">Everything on FluxStack</span>
                <span class="btn btn-primary">Subscribe <span class="arrow" aria-hidden="true">&rarr;</span></span>
            </span>
        </a>
    </div>

    <div class="wrap">
        <div class="rail-bar" aria-hidden="true"><span data-rail-progress></span></div>
    </div>
</section>

<style>
    .videos-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
    }

    .rail-controls {
        display: flex;
        gap: 8px;
        margin-bottom: clamp(40px, 6vw, 72px);
    }

    .rail-btn {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-strong);
        transition:
            background-color 0.3s,
            color 0.3s,
            border-radius var(--swap);
    }

    .rail-btn:hover {
        background: var(--text);
        color: var(--bg);
    }

    .rail {
        --card: clamp(260px, 26vw, 340px);
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: var(--card);
        gap: 20px;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
        padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
        padding-block: 4px 12px;
        scrollbar-width: none;
        cursor: grab;
    }

    .rail::-webkit-scrollbar {
        display: none;
    }

    .rail.is-dragging {
        cursor: grabbing;
        scroll-snap-type: none;
    }

    .rail.is-dragging .vid {
        pointer-events: none;
    }

    .vid {
        display: grid;
        grid-template-rows: auto auto 1fr;
        gap: 12px;
        scroll-snap-align: start;
    }

    .vid-thumb {
        position: relative;
        display: block;
        box-shadow: var(--shadow);
        will-change: transform;
        aspect-ratio: 16 / 9;
        max-width: 100%;
        border-radius: var(--radius);
        overflow: hidden;
        background: var(--surface-2);
        transition: border-radius var(--swap);
    }

    .vid-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s var(--ease-out);
        user-select: none;
    }

    .vid:hover .vid-thumb img {
        transform: scale(1.06);
    }

    .vid:hover .vid-thumb {
        box-shadow: var(--shadow-lift);
    }

    .vid-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        padding: 4px 9px;
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--bg) 70%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: var(--text);
        transition: border-radius var(--swap);
    }

    .vid-play {
        position: absolute;
        right: 12px;
        bottom: 12px;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border-radius: var(--radius-pill);
        background: var(--accent);
        color: var(--accent-ink);
        transform: scale(0.6);
        opacity: 0;
        transition:
            transform 0.45s var(--ease-out),
            opacity 0.3s,
            border-radius var(--swap),
            background-color var(--swap);
    }

    .vid:hover .vid-play,
    .vid:focus-visible .vid-play {
        transform: scale(1);
        opacity: 1;
    }

    .vid-title {
        font-weight: 500;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.3s;
    }

    .vid:hover .vid-title {
        color: var(--accent);
    }

    .vid-meta {
        display: flex;
        gap: 14px;
        font-size: 0.78rem;
        color: var(--muted);
    }

    .vid-more {
        align-self: stretch;
    }

    .vid-more-inner {
        display: grid;
        align-content: center;
        justify-items: start;
        gap: 16px;
        height: 100%;
        min-height: 200px;
        padding: 28px;
        border-style: dashed;
    }

    .vid-more-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .rail-bar {
        position: relative;
        height: 2px;
        margin-top: 28px;
        background: var(--line);
        border-radius: 2px;
        overflow: hidden;
    }

    .rail-bar span {
        position: absolute;
        inset: 0;
        background: var(--accent);
        transform-origin: left;
        transform: scaleX(0.15);
    }

    @media (max-width: 640px) {
        .rail-controls {
            display: none;
        }
    }
</style>
