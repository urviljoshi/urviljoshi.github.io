---
import { videos, shorts, channel, fmtDate, compactViews, cleanTitle } from '../data/content';

const groups = [
    {
        id: 'long',
        title: 'Videos',
        blurb: 'Deep dives and builds',
        items: videos,
        more: { href: channel.url, label: 'Channel', title: 'Everything on FluxStack', cta: 'Subscribe' }
    },
    {
        id: 'shorts',
        title: 'Shorts',
        blurb: 'One idea in under a minute',
        items: shorts,
        more: { href: `${channel.url}/shorts`, label: 'Shorts', title: 'All Shorts', cta: 'Watch' }
    }
].filter((g) => g.items.length);
---

<section class="section videos" id="videos" data-section="videos">
    <div class="wrap">
        <header class="section-head">
            <p class="label" data-reveal>FluxStack on YouTube</p>
            <h2 class="section-title" data-split>Ideas, taken apart <em>on camera</em>.</h2>
        </header>
    </div>

    {groups.map((g) => (
        <div class:list={['rail-group', `rail-group-${g.id}`]} data-rail-group>
            <div class="wrap rail-head" data-reveal>
                <div class="rail-heading">
                    <h3 class="rail-title">
                        {g.title} <span class="rail-count mono">{g.items.length}</span>
                    </h3>
                    <p class="rail-blurb">{g.blurb}</p>
                </div>
                <div class="rail-controls">
                    <button class="rail-btn" type="button" data-rail-prev aria-label={`Previous ${g.title.toLowerCase()}`}>&larr;</button>
                    <button class="rail-btn" type="button" data-rail-next aria-label={`Next ${g.title.toLowerCase()}`}>&rarr;</button>
                </div>
            </div>

            <div class:list={['rail', { 'rail-shorts': g.id === 'shorts' }]} data-rail tabindex="0" aria-label={`Recent ${g.title.toLowerCase()}`}>
                {g.items.map((item) => (
                    <a href={item.url} target="_blank" rel="noopener" class:list={['vid', { 'vid-short': item.short }]} data-stagger-item>
                        <span class="vid-thumb" data-tilt data-tilt-max={item.short ? '10' : '8'}>
                            <img
                                src={item.thumbnail}
                                alt=""
                                width={item.short ? 360 : 640}
                                height={item.short ? 640 : 360}
                                loading="lazy"
                                draggable="false"
                            />
                            <span class="vid-play" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
                            </span>
                        </span>
                        <span class="vid-title">{cleanTitle(item.title)}</span>
                        <span class="vid-meta mono">
                            <span>{fmtDate(item.date)}</span>
                            {item.views > 0 && <span>{compactViews(item.views)} views</span>}
                        </span>
                    </a>
                ))}
                <a href={g.more.href} target="_blank" rel="noopener" class:list={['vid', 'vid-more', { 'vid-short': g.id === 'shorts' }]}>
                    <span class="vid-more-inner card orbit" data-spotlight>
                        <span class="label">{g.more.label}</span>
                        <span class="vid-more-title">{g.more.title}</span>
                        <span class="btn btn-primary">
                            {g.more.cta} <span class="arrow" aria-hidden="true">&rarr;</span>
                        </span>
                    </span>
                </a>
            </div>

            <div class="wrap">
                <div class="rail-bar" aria-hidden="true"><span data-rail-progress></span></div>
            </div>
        </div>
    ))}
</section>

<style>
    .rail-group + .rail-group {
        margin-top: clamp(56px, 8vw, 104px);
    }

    .rail-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
    }

    .rail-heading {
        display: grid;
        gap: 4px;
    }

    .rail-title {
        display: flex;
        align-items: baseline;
        gap: 12px;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(1.5rem, 2.6vw, 2.1rem);
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .rail-count {
        font-size: 0.8rem;
        font-weight: 400;
        letter-spacing: 0;
        color: var(--muted);
    }

    .rail-blurb {
        color: var(--muted);
        font-size: 0.95rem;
    }

    .rail-controls {
        display: flex;
        gap: 8px;
    }

    .rail-btn {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-strong);
        transition:
            background-color 0.3s,
            color 0.3s,
            border-radius var(--swap);
    }

    .rail-btn:hover {
        background: var(--text);
        color: var(--bg);
    }

    .rail {
        --card: clamp(260px, 26vw, 340px);
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: var(--card);
        gap: 20px;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
        padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
        padding-block: 4px 12px;
        scrollbar-width: none;
        cursor: grab;
    }

    /* Shorts: narrow, phone-shaped cards */
    .rail-shorts {
        --card: clamp(150px, 15vw, 210px);
        gap: 16px;
    }

    .vid-short .vid-thumb {
        aspect-ratio: 9 / 16;
    }

    .vid-short .vid-title {
        font-size: 0.9rem;
    }

    .vid-short .vid-meta {
        gap: 10px;
        font-size: 0.72rem;
    }

    .vid-short .vid-play {
        width: 40px;
        height: 40px;
        right: 10px;
        bottom: 10px;
    }

    .vid-short .vid-more-title {
        font-size: 1.25rem;
    }

    .vid-short.vid-more .vid-more-inner {
        aspect-ratio: 9 / 16;
        min-height: 0;
        padding: 20px;
    }

    .rail::-webkit-scrollbar {
        display: none;
    }

    .rail.is-dragging {
        cursor: grabbing;
        scroll-snap-type: none;
    }

    .rail.is-dragging .vid {
        pointer-events: none;
    }

    .vid {
        display: grid;
        grid-template-rows: auto auto 1fr;
        gap: 12px;
        scroll-snap-align: start;
    }

    .vid-thumb {
        position: relative;
        display: block;
        box-shadow: var(--shadow);
        will-change: transform;
        aspect-ratio: 16 / 9;
        max-width: 100%;
        border-radius: var(--radius);
        overflow: hidden;
        background: var(--surface-2);
        transition: border-radius var(--swap);
    }

    .vid-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s var(--ease-out);
        user-select: none;
    }

    .vid:hover .vid-thumb img {
        transform: scale(1.06);
    }

    .vid:hover .vid-thumb {
        box-shadow: var(--shadow-lift);
    }


    .vid-play {
        position: absolute;
        right: 12px;
        bottom: 12px;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border-radius: var(--radius-pill);
        background: var(--accent);
        color: var(--accent-ink);
        transform: scale(0.6);
        opacity: 0;
        transition:
            transform 0.45s var(--ease-out),
            opacity 0.3s,
            border-radius var(--swap),
            background-color var(--swap);
    }

    .vid:hover .vid-play,
    .vid:focus-visible .vid-play {
        transform: scale(1);
        opacity: 1;
    }

    .vid-title {
        font-weight: 500;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.3s;
    }

    .vid:hover .vid-title {
        color: var(--accent);
    }

    .vid-meta {
        display: flex;
        gap: 14px;
        font-size: 0.78rem;
        color: var(--muted);
    }

    .vid-more {
        align-self: stretch;
    }

    .vid-more-inner {
        display: grid;
        align-content: center;
        justify-items: start;
        gap: 16px;
        height: 100%;
        min-height: 200px;
        padding: 28px;
        border-style: dashed;
    }

    .vid-more-title {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

    .rail-bar {
        position: relative;
        height: 2px;
        margin-top: 28px;
        background: var(--line);
        border-radius: 2px;
        overflow: hidden;
    }

    .rail-bar span {
        position: absolute;
        inset: 0;
        background: var(--accent);
        transform-origin: left;
        transform: scaleX(0.15);
    }

    @media (max-width: 640px) {
        .rail-controls {
            display: none;
        }
    }
</style>
