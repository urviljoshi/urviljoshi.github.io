---
import { person, socials, buildYear } from '../data/content';
---

<section class="section contact" id="contact" data-section="contact">
    <div class="wrap">
        <p class="label" data-reveal>Contact</p>
        <h2 class="contact-title" data-split>Let&rsquo;s build <em>something</em>.</h2>

        <div class="contact-grid">
            <div class="contact-main" data-reveal>
                <p class="lede">
                    Open to collaborations. A question, a project idea or a video topic, all welcome.
                </p>
                <div class="email-row">
                    <a href={`mailto:${person.email}`} class="email" data-magnetic>{person.email}</a>
                    <button type="button" class="copy label" data-copy={person.email}>
                        <span data-copy-label>Copy</span>
                    </button>
                </div>
                <p class="phone mono">{person.phone}</p>
            </div>

            <ul class="socials" data-stagger>
                {socials.map((s) => (
                    <li>
                        <a href={s.href} target="_blank" rel="noopener" class="social">
                            <span class="social-name">{s.label}</span>
                            <span class="social-handle mono">{s.handle}</span>
                            <span class="social-go" aria-hidden="true">&nearr;</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>

    <footer class="footer wrap">
        <span class="mono">&copy; {buildYear} {person.name}</span>
        <span class="mono">Built with Astro and GSAP</span>
        <a href="#top" class="mono link">Back to top &uarr;</a>
    </footer>
</section>

<style>
    .contact {
        padding-bottom: 0;
    }

    .contact-title {
        font-family: var(--font-display);
        font-optical-sizing: auto;
        font-weight: 600;
        font-size: clamp(3.5rem, 11vw, 10rem);
        line-height: 0.9;
        letter-spacing: -0.05em;
        margin: 20px 0 clamp(40px, 6vw, 80px);
        text-wrap: balance;
    }

    .contact-title em {
        font-style: normal;
        color: var(--accent);
        transition: color var(--swap);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 7fr 5fr;
        gap: 48px;
        align-items: end;
    }

    .contact-main {
        display: grid;
        gap: 24px;
    }

    .email-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
    }

    .email {
        display: inline-block;
        font-family: var(--font-display);
        font-weight: 500;
        font-size: clamp(1.5rem, 3.6vw, 2.75rem);
        letter-spacing: -0.03em;
        border-bottom: 1px solid var(--line-strong);
        padding-bottom: 4px;
        user-select: all;
        overflow-wrap: anywhere;
        transition:
            color 0.3s,
            border-color 0.3s;
    }

    .email:hover {
        color: var(--accent);
        border-color: var(--accent);
    }

    .copy {
        padding: 8px 14px;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-pill);
        color: var(--text);
        transition:
            background-color 0.3s,
            color 0.3s,
            border-radius var(--swap);
    }

    .copy:hover {
        background: var(--text);
        color: var(--bg);
    }

    .phone {
        color: var(--muted);
        font-size: 0.9rem;
        user-select: all;
    }

    .socials {
        border-top: 1px solid var(--line);
    }

    .social {
        display: grid;
        grid-template-columns: 1fr auto 28px;
        align-items: baseline;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
    }

    .social-name {
        font-weight: 500;
        transition: transform 0.45s var(--ease-out);
    }

    .social:hover .social-name {
        transform: translateX(6px);
    }

    .social-handle {
        font-size: 0.8rem;
        color: var(--muted);
    }

    .social-go {
        justify-self: end;
        transition:
            transform 0.45s var(--ease-out),
            color 0.3s;
    }

    .social:hover .social-go {
        transform: rotate(45deg);
        color: var(--accent);
    }

    .footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px 32px;
        margin-top: clamp(80px, 12vw, 160px);
        padding-block: 28px calc(env(safe-area-inset-bottom, 0px) + 96px);
        border-top: 1px solid var(--line);
        font-size: 0.8rem;
        color: var(--muted);
    }

    @media (max-width: 860px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
