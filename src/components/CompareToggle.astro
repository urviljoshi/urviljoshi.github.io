---
// Prototype-only control for choosing a direction. Removed once one wins.
---

<div class="compare" role="group" aria-label="Design direction" data-compare>
    <span class="compare-thumb" aria-hidden="true" data-compare-thumb></span>
    <button type="button" class="compare-opt" data-set-variant="sleek" aria-pressed="true">Sleek</button>
    <button type="button" class="compare-opt" data-set-variant="pixel" aria-pressed="false">Pixel accents</button>
</div>

<style>
    .compare {
        position: fixed;
        left: 50%;
        bottom: calc(env(safe-area-inset-bottom, 0px) + 18px);
        transform: translateX(-50%);
        z-index: 60;
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 1fr;
        padding: 5px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--surface-2) 85%, transparent);
        border: 1px solid var(--line-strong);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.7);
        isolation: isolate;
    }

    .compare-thumb {
        position: absolute;
        top: 5px;
        bottom: 5px;
        left: 5px;
        width: calc(50% - 5px);
        border-radius: 999px;
        background: var(--accent);
        z-index: -1;
        transition:
            transform 0.55s var(--ease-out),
            background-color var(--swap);
    }

    :global([data-variant='pixel']) .compare-thumb {
        transform: translateX(100%);
    }

    .compare-opt {
        min-width: 136px;
        height: 42px;
        padding-inline: 16px;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 500;
        white-space: nowrap;
        color: var(--muted);
        transition: color 0.4s;
    }

    :global(.hero) {
        padding-bottom: 108px !important;
    }

    .compare-opt[aria-pressed='true'] {
        color: var(--accent-ink);
    }
</style>
