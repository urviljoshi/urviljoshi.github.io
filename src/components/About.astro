---
import { person, yearsExperience, education } from '../data/content';

const facts = [
    { k: 'Now', v: `${person.role}, HARMAN` },
    { k: 'Before', v: 'MOSIP at Mindtree' },
    { k: 'Experience', v: `${yearsExperience}+ years` },
    { k: 'Studied', v: `${education.degree}, ${education.school}` }
];
---

<section class="section about" id="about" data-section="about">
    <div class="wrap about-grid">
        <figure class="about-portrait" data-reveal>
            <div class="portrait-frame">
                <img src={person.portrait} alt="Portrait of Urvil Joshi" width="400" height="400" loading="lazy" data-pixelate />
            </div>
        </figure>

        <div class="about-body">
            <p class="label" data-reveal>About</p>
            <h2 class="section-title about-title" data-split>
                I build backend systems that <em>stay up</em>.
            </h2>
            <div class="about-copy" data-reveal>
                <p>
                    Today that means connected-vehicle services at HARMAN. Before that, nearly five years on MOSIP, an
                    open-source identity platform that national ID programs run on. Mostly Java, Spring Boot and
                    microservices, with a soft spot for concurrency and the unglamorous work of making systems
                    observable.
                </p>
                <p>
                    I also write and record what I learn. On Medium that's Java internals and, lately, how AI coding
                    agents hold up in real workflows. On YouTube I run FluxStack, where I take the same ideas apart on
                    camera.
                </p>
            </div>

            <dl class="facts" data-stagger>
                {facts.map((f) => (
                    <div class="fact">
                        <dt class="label">{f.k}</dt>
                        <dd>{f.v}</dd>
                    </div>
                ))}
            </dl>
        </div>
    </div>
</section>

<style>
    .about-grid {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: clamp(32px, 6vw, 96px);
        align-items: start;
    }

    .about-portrait {
        position: sticky;
        top: 120px;
    }

    .portrait-frame {
        position: relative;
        aspect-ratio: 4 / 5;
        max-width: 100%;
        border-radius: var(--radius);
        overflow: hidden;
        background: var(--surface-2);
        border: 1px solid var(--line);
        transition: border-radius var(--swap);
    }

    .portrait-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .about-body {
        display: grid;
        gap: 28px;
    }

    .about-title {
        max-width: 14ch;
    }

    .about-copy {
        display: grid;
        gap: 18px;
        color: var(--muted);
        max-width: 60ch;
    }

    .facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--line);
        margin: 12px 0 0;
    }

    .fact {
        display: grid;
        gap: 6px;
        padding: 20px 20px 20px 0;
        border-bottom: 1px solid var(--line);
    }

    .fact dd {
        margin: 0;
        font-size: 1rem;
    }

    @media (max-width: 820px) {
        .about-grid {
            grid-template-columns: 1fr;
        }
        .about-portrait {
            position: static;
            max-width: 320px;
        }
    }

    @media (max-width: 480px) {
        .facts {
            grid-template-columns: 1fr;
        }
    }
</style>
