---
import { person } from '../data/content';

const links = [
    { href: '#about', label: 'About' },
    { href: '#career', label: 'Career' },
    { href: '#work', label: 'Work' },
    { href: '#writing', label: 'Writing' },
    { href: '#videos', label: 'Videos' }
];
---

<header class="nav" data-nav>
    <div class="nav-bar">
        <a href="#top" class="nav-mark" aria-label="Back to top">
            <span class="nav-mark-uj">UJ</span>
        </a>

        <nav aria-label="Sections" class="nav-links">
            {links.map((l) => (
                <a href={l.href} class="nav-link" data-nav-link={l.href.slice(1)}>
                    {l.label}
                </a>
            ))}
        </nav>

        <div class="nav-actions">
            <button class="theme-btn" type="button" data-theme-toggle aria-label="Switch colour theme">
                <svg class="theme-ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <mask id="moon-cut">
                        <rect width="24" height="24" fill="#fff" />
                        <circle class="theme-cut" cx="24" cy="4" r="8" fill="#000" />
                    </mask>
                    <circle class="theme-core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#moon-cut)" />
                    <g class="theme-rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="12" y1="1.5" x2="12" y2="3.5" />
                        <line x1="12" y1="20.5" x2="12" y2="22.5" />
                        <line x1="1.5" y1="12" x2="3.5" y2="12" />
                        <line x1="20.5" y1="12" x2="22.5" y2="12" />
                        <line x1="4.6" y1="4.6" x2="6" y2="6" />
                        <line x1="18" y1="18" x2="19.4" y2="19.4" />
                        <line x1="4.6" y1="19.4" x2="6" y2="18" />
                        <line x1="18" y1="6" x2="19.4" y2="4.6" />
                    </g>
                </svg>
            </button>
            <a href="#contact" class="nav-cta">Contact</a>
            <button class="nav-menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
                <span class="sr-only">Open menu</span>
                <span class="nav-menu-bars" aria-hidden="true"><i></i><i></i></span>
            </button>
        </div>
        <span class="nav-progress" data-progress aria-hidden="true"></span>
    </div>
</header>

<div class="menu" id="menu" data-menu hidden>
    <nav class="menu-inner" aria-label="Menu">
        {[...links, { href: '#contact', label: 'Contact' }].map((l) => (
            <a href={l.href} class="menu-link" data-menu-link>
                {l.label}
            </a>
        ))}
        <a href={person.resume} class="menu-resume label" target="_blank" rel="noopener">Resume (PDF)</a>
    </nav>
</div>

<style>
    .nav {
        position: fixed;
        top: var(--nav-top);
        left: 0;
        right: 0;
        z-index: 50;
        padding-inline: var(--gutter);
        pointer-events: none;
        transition: transform 0.5s var(--ease-out);
    }

    .nav.is-hidden {
        transform: translateY(calc(-100% - var(--nav-top) - 8px));
    }

    .nav-bar {
        pointer-events: auto;
        position: relative;
        max-width: 880px;
        margin-inline: auto;
        display: flex;
        align-items: center;
        gap: 12px;
        height: 56px;
        padding: 0 8px 0 10px;
        border-radius: var(--radius-pill);
        border: 1px solid color-mix(in srgb, var(--line-strong) 70%, transparent);
        background: var(--glass);
        backdrop-filter: blur(16px) saturate(140%);
        -webkit-backdrop-filter: blur(16px) saturate(140%);
        overflow: hidden;
        transition:
            border-radius var(--swap),
            background-color var(--swap),
            border-color var(--swap);
    }

    .nav-mark {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: var(--radius-pill);
        background: var(--accent);
        color: var(--accent-ink);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: -0.02em;
        flex-shrink: 0;
        transition:
            background-color var(--swap),
            border-radius var(--swap);
    }

    .nav-links {
        display: flex;
        gap: 2px;
        margin-inline: auto;
    }

    .nav-link {
        position: relative;
        padding: 8px 14px;
        font-size: 0.9rem;
        color: var(--muted);
        border-radius: var(--radius-pill);
        transition:
            color 0.3s,
            background-color 0.3s;
    }

    .nav-link:hover,
    .nav-link.is-active {
        color: var(--text);
    }

    .nav-link.is-active {
        background: var(--surface-2);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .nav-cta {
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding-inline: 18px;
        border-radius: var(--radius-pill);
        background: var(--text);
        color: var(--bg);
        font-size: 0.9rem;
        font-weight: 500;
        transition:
            background-color 0.3s,
            border-radius var(--swap);
    }

    .nav-cta:hover {
        background: var(--accent);
    }

    .nav-progress {
        position: absolute;
        left: 0;
        bottom: 0;
        height: 2px;
        width: 100%;
        background: var(--accent);
        transform-origin: left;
        transform: scaleX(0);
        opacity: 0.8;
    }

    /* Sun in light, moon in dark. --dark is a registered number that the
       theme tokens set, so the morph tweens on its own. */
    .theme-btn {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: var(--radius-pill);
        color: var(--text);
        transition: background-color 0.3s;
    }

    .theme-btn:hover {
        background: var(--surface-2);
    }

    .theme-ic {
        transition: --dark 0.6s var(--ease-out);
        transform: rotate(calc(var(--dark) * 40deg));
        overflow: visible;
    }

    .theme-core {
        transform-origin: 12px 12px;
        transform: scale(calc(1 + var(--dark) * 0.75));
    }

    .theme-cut {
        transform: translate(calc(var(--dark) * -8px), calc(var(--dark) * 4px));
    }

    .theme-rays {
        transform-origin: 12px 12px;
        transform: rotate(calc(var(--dark) * -90deg)) scale(calc(1 - var(--dark)));
        opacity: calc(1 - var(--dark));
    }

    .nav-menu {
        display: none;
        width: 40px;
        height: 40px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-strong);
        place-items: center;
    }

    .nav-menu-bars {
        display: grid;
        gap: 5px;
    }

    .nav-menu-bars i {
        display: block;
        width: 16px;
        height: 1.5px;
        background: currentColor;
    }

    @media (max-width: 760px) {
        .nav-links {
            display: none;
        }
        .nav-actions {
            margin-left: auto;
        }
        .nav-menu {
            display: grid;
        }
    }

    .menu {
        position: fixed;
        inset: 0;
        z-index: 49;
        background: var(--bg);
        padding: calc(var(--nav-top) + 96px) var(--gutter) calc(env(safe-area-inset-bottom, 0px) + 32px);
        overflow-y: auto;
    }

    .menu-inner {
        display: grid;
        gap: 4px;
    }

    .menu-link {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: clamp(2.5rem, 12vw, 4rem);
        letter-spacing: -0.035em;
        line-height: 1.1;
    }

    .menu-resume {
        margin-top: 32px;
        color: var(--accent);
    }
</style>
