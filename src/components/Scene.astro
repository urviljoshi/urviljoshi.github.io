---
/* ========================================================================
   Desk scene — Urvil at work, seen from behind.
   Hand-built SVG so every part can move on its own and follow the theme:
   daytime room in light mode; lamp, string lights and screen glow at night.
   Layers (back to front) carry data-layer for cursor parallax:
     wall  -> art, poster, notes, string lights
     desk  -> monitor, desk, lamp, mug, plant, tower
     char  -> the person and the chair
   The monitor's code is typed live by src/scripts/scene.ts.
   ======================================================================== */

// String lights hang in a shallow curve across the top of the wall
const bulbs = Array.from({ length: 11 }, (_, i) => {
    const t = 0.04 + i * 0.092;
    const x = (1 - t) ** 2 * 18 + 2 * (1 - t) * t * 320 + t ** 2 * 622;
    const y = (1 - t) ** 2 * 14 + 2 * (1 - t) * t * 64 + t ** 2 * 14;
    return { x, y, c: ['var(--sc-b1)', 'var(--sc-b2)', 'var(--sc-b3)', 'var(--sc-b4)'][i % 4], d: (i * 0.37) % 2.2 };
});

// Wavy curls. The silhouette is an ellipse whose radius rides two sine
// waves, flattened into a soft wavy line at the nape. Inside, S-shaped
// strands flow out from the crown; each wave swings wider as the strand
// gets longer, and a light gravity term makes the side strands fall.
// Seeded, so the hair is identical on every build.
const seed = (i: number) => {
    const x = Math.sin(i * 12.9898) * 43758.5453;
    return x - Math.floor(x);
};
const f1 = (n: number) => n.toFixed(1);
const HX = 320;
const HY = 292;

const outline: [number, number][] = [];
for (let i = 0; i <= 200; i++) {
    const t = (i / 200) * Math.PI * 2;
    const wave = 1 + 0.07 * Math.sin(t * 9 + 0.6) + 0.03 * Math.sin(t * 4 + 1.3);
    const x = HX + Math.cos(t) * 64 * wave;
    let y = HY + Math.sin(t) * 66 * wave;
    const nape = 348 + 3 * Math.sin(x * 0.35);
    if (y > nape) y = nape;
    outline.push([x, y]);
}
const toPath = (pts: [number, number][]) => 'M' + pts.map((p) => `${f1(p[0])},${f1(p[1])}`).join(' L');
const hairPath = toPath(outline) + ' Z';
// The top half only, for the screen light on dark mode
const rimPath = toPath(outline.slice(100, 201));

type Strand = { d: string; dash: number };
const strand = (ox: number, oy: number, a: number, len: number, k: number): Strand => {
    const amp = 7 + seed(k + 640) * 3.5;
    const ph = seed(k + 680) * Math.PI * 2;
    const freq = 0.085 + seed(k + 720) * 0.02;
    const pts: [number, number][] = [];
    for (let d = 0; d <= len; d += 3) {
        const off = amp * Math.sin(d * freq + ph) * Math.min(1, d / 16);
        pts.push([
            ox + Math.cos(a) * d - Math.sin(a) * off,
            oy + Math.sin(a) * d + Math.cos(a) * off + 0.0035 * d * d
        ]);
    }
    return { d: toPath(pts), dash: Math.round(seed(k + 760) * 20) };
};
const CROWN = { x: 324, y: 256 };
const strands: Strand[] = [
    ...Array.from({ length: 16 }, (_, i) => strand(CROWN.x, CROWN.y, (i / 16) * Math.PI * 2 + seed(i + 600) * 0.15, 120, i)),
    ...Array.from({ length: 12 }, (_, i) => {
        const a = (i / 12) * Math.PI * 2 + 0.26;
        return strand(CROWN.x + Math.cos(a) * 26, CROWN.y + Math.sin(a) * 28, a + (seed(i + 800) - 0.5) * 0.25, 90, i + 100);
    })
];

const notes = [
    { x: 516, y: 218, r: -8, c: '#ffe27a', text: 'ship it' },
    { x: 556, y: 208, r: 6, c: '#a9c1ff', text: '' },
    { x: 590, y: 232, r: -4, c: '#ff9fb2', text: 'p99 < 200ms' },
    { x: 540, y: 250, r: 5, c: '#9fe8c8', text: '' }
];
---

<div class="scene" data-scene>
    <svg
        class="scene-svg"
        viewBox="0 0 640 560"
        role="img"
        aria-label="Illustration of Urvil at his desk, seen from behind, writing Java code on a monitor"
    >
        <defs>
            <radialGradient id="sc-glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.9" />
                <stop offset="55%" stop-color="var(--accent)" stop-opacity="0.25" />
                <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="sc-cone" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#ffd98a" stop-opacity="0.55" />
                <stop offset="100%" stop-color="#ffd98a" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="sc-rgb" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#f0566a" />
                <stop offset="50%" stop-color="#5be3b0" />
                <stop offset="100%" stop-color="#ff9fb2" />
            </linearGradient>
            <clipPath id="sc-screen-clip">
                <rect x="162" y="177" width="316" height="200" rx="5" />
            </clipPath>
        </defs>

        <!-- ================= WALL ================= -->
        <g data-layer="wall" data-depth="8">
            <!-- string lights -->
            <path d="M18,14 Q320,64 622,14" fill="none" stroke="var(--sc-wire)" stroke-width="1.5" />
            {bulbs.map((b) => (
                <g class="bulb" style={`--d:${b.d}s`}>
                    <line x1={b.x} y1={b.y} x2={b.x} y2={b.y + 5} stroke="var(--sc-wire)" stroke-width="1.5" />
                    <circle class="bulb-halo" cx={b.x} cy={b.y + 10} r="9" fill={b.c} />
                    <circle cx={b.x} cy={b.y + 10} r="4" fill={b.c} />
                </g>
            ))}

            <!-- framed abstract, left -->
            <g transform="translate(38 74) rotate(-4)"><g class="sway" style="--d:0s">
                <rect width="118" height="148" rx="3" fill="var(--sc-paper)" stroke="var(--sc-frame)" stroke-width="6" />
                <circle cx="48" cy="58" r="30" fill="var(--accent)" opacity="0.9" />
                <circle cx="74" cy="86" r="24" fill="#ffb454" opacity="0.85" />
                <rect x="20" y="104" width="46" height="26" rx="2" fill="var(--live)" opacity="0.8" />
            </g></g>

            <!-- small square stripes -->
            <g transform="translate(180 40) rotate(3)"><g class="sway" style="--d:1.2s">
                <rect width="74" height="74" rx="2" fill="var(--sc-paper)" stroke="var(--sc-frame)" stroke-width="5" />
                <g stroke-width="7" stroke-linecap="round">
                    <line x1="14" y1="58" x2="36" y2="14" stroke="#ff9fb2" />
                    <line x1="30" y1="60" x2="52" y2="16" stroke="var(--accent)" />
                    <line x1="46" y1="60" x2="62" y2="26" stroke="#ffb454" />
                </g>
            </g></g>

            <!-- landscape print -->
            <g transform="translate(30 250) rotate(2)"><g class="sway" style="--d:0.6s">
                <rect width="88" height="64" rx="2" fill="var(--sc-sky)" stroke="var(--sc-frame)" stroke-width="5" />
                <circle cx="64" cy="20" r="8" fill="#ffb454" />
                <polygon points="4,60 30,26 48,46 60,34 84,60" fill="var(--sc-hill)" />
            </g></g>

            <!-- FluxStack poster with tape -->
            <g transform="translate(478 48) rotate(4)"><g class="sway" style="--d:1.8s">
                <rect width="112" height="150" rx="2" fill="var(--accent)" />
                <text x="12" y="60" class="poster-big">flux</text>
                <text x="12" y="96" class="poster-big poster-out">stack</text>
                <text x="12" y="134" class="poster-small">/ youtube</text>
                <rect x="-8" y="-6" width="30" height="12" fill="var(--sc-tape)" transform="rotate(-18)" />
                <rect x="92" y="-2" width="30" height="12" fill="var(--sc-tape)" transform="rotate(16 106 4)" />
            </g></g>

            <!-- sticky notes -->
            {notes.map((n, i) => (
                <g transform={`translate(${n.x} ${n.y}) rotate(${n.r})`}><g class="note" style={`--d:${i * 0.45}s`}>
                    <rect x="-17" y="-17" width="34" height="34" rx="1.5" fill={n.c} />
                    {n.text ? (
                        <text x="0" y="3" class="note-text" text-anchor="middle">{n.text}</text>
                    ) : (
                        <g stroke="rgba(0,0,0,0.28)" stroke-width="1.6" stroke-linecap="round">
                            <line x1="-10" y1="-6" x2="9" y2="-6" />
                            <line x1="-10" y1="0" x2="6" y2="0" />
                            <line x1="-10" y1="6" x2="8" y2="6" />
                        </g>
                    )}
                </g></g>
            ))}
        </g>

        <!-- ================= DESK ================= -->
        <g data-layer="desk" data-depth="14">
            <!-- screen glow on the wall -->
            <ellipse class="glow" cx="320" cy="285" rx="270" ry="180" fill="url(#sc-glow)" />

            <!-- monitor -->
            <rect x="310" y="398" width="20" height="44" rx="3" fill="var(--sc-metal)" />
            <ellipse cx="320" cy="442" rx="58" ry="6" fill="var(--sc-metal)" />
            <rect x="150" y="165" width="340" height="235" rx="12" fill="var(--sc-monitor)" />
            <rect x="162" y="177" width="316" height="200" rx="5" fill="#0e1522" />

            <g clip-path="url(#sc-screen-clip)" class="screen">
                <!-- editor chrome -->
                <rect x="162" y="177" width="316" height="17" fill="#151d2b" />
                <rect x="168" y="180" width="104" height="14" rx="3" fill="#0e1522" />
                <circle cx="175" cy="187" r="2.5" fill="#ffb454" data-tabdot />
                <text x="182" y="190" class="tab" data-tab>TelemetryController.java</text>
                <g data-codebg></g>
                <g data-gutter class="gutter"></g>
                <g data-code class="code"></g>
                <rect data-caret class="caret" x="192" y="201" width="5" height="10" fill="#f0566a" />
                <!-- status bar -->
                <rect x="162" y="368" width="316" height="9" fill="#4a1c24" />
                <text x="168" y="375" class="status">main</text>
                <text x="472" y="375" class="status" text-anchor="end" data-status>Java · UTF-8</text>
            </g>

            <!-- desk -->
            <rect x="10" y="440" width="620" height="12" rx="3" fill="var(--sc-desk-top)" />
            <rect x="20" y="452" width="600" height="140" fill="var(--sc-desk)" />

            <!-- lamp -->
            <g class="lamp">
                <polygon class="lamp-cone" points="118,338 154,326 214,440 52,440" fill="url(#sc-cone)" />
                <ellipse cx="72" cy="440" rx="22" ry="5" fill="var(--sc-metal)" />
                <path d="M72,440 L92,364 L128,326" fill="none" stroke="var(--sc-metal)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="92" cy="364" r="4.5" fill="var(--sc-metal)" />
                <path d="M110,316 L150,302 L158,328 L120,342 Z" fill="var(--accent)" />
                <circle class="lamp-bulb" cx="140" cy="334" r="6" fill="#ffe6ad" />
            </g>

            <!-- mug with steam -->
            <g class="mug">
                <path class="steam" d="M126,404 q-6,-10 0,-20 q6,-10 0,-20" fill="none" stroke="var(--sc-steam)" stroke-width="2.4" stroke-linecap="round" />
                <path class="steam s2" d="M136,404 q-6,-10 0,-20 q6,-10 0,-20" fill="none" stroke="var(--sc-steam)" stroke-width="2.4" stroke-linecap="round" />
                <rect x="116" y="410" width="30" height="30" rx="5" fill="var(--sc-mug)" />
                <path d="M146,418 q12,0 12,9 q0,9 -12,9" fill="none" stroke="var(--sc-mug)" stroke-width="4" />
                <rect x="121" y="418" width="20" height="3" rx="1.5" fill="var(--accent)" opacity="0.8" />
            </g>

            <!-- plant -->
            <g class="plant">
                <g class="leaves">
                    <ellipse cx="444" cy="388" rx="7" ry="20" fill="var(--sc-leaf)" transform="rotate(-28 444 404)" />
                    <ellipse cx="458" cy="382" rx="7" ry="22" fill="var(--sc-leaf-2)" transform="rotate(4 458 402)" />
                    <ellipse cx="472" cy="390" rx="7" ry="18" fill="var(--sc-leaf)" transform="rotate(30 472 404)" />
                </g>
                <path d="M440,404 L476,404 L471,440 L445,440 Z" fill="#c97a55" />
            </g>

            <!-- tower -->
            <g class="tower">
                <rect x="506" y="290" width="96" height="150" rx="7" fill="var(--sc-case)" />
                <rect x="516" y="302" width="64" height="126" rx="4" fill="#0b1018" />
                {[338, 392].map((cy) => (
                    <g>
                        <circle cx="548" cy={cy} r="21" fill="none" stroke="#2a3546" stroke-width="3" />
                        <g class="fan">
                            {[0, 90, 180, 270].map((a) => (
                                <ellipse cx="548" cy={cy - 9} rx="5" ry="10" fill="var(--accent)" opacity="0.7" transform={`rotate(${a} 548 ${cy})`} />
                            ))}
                            <circle cx="548" cy={cy} r="4" fill="#2a3546" />
                        </g>
                    </g>
                ))}
                <rect class="rgb" x="588" y="302" width="5" height="126" rx="2.5" fill="url(#sc-rgb)" />
                <circle class="power" cx="590" cy="296" r="2" fill="var(--live)" />
            </g>
        </g>

        <!-- ================= CHARACTER ================= -->
        <g data-layer="char" data-depth="22">
            <!-- seated a little right of the monitor so the start of each line stays readable -->
            <g transform="translate(62 14)">
            <g class="person" data-person>
                <!-- arms: bare forearms, short tee sleeves over the shoulders -->
                <g class="arm arm-l">
                    <path d="M236,424 Q208,454 214,492" fill="none" stroke="var(--sc-skin)" stroke-width="24" stroke-linecap="round" />
                    <path d="M214,492 L258,452" fill="none" stroke="var(--sc-skin)" stroke-width="20" stroke-linecap="round" />
                    <path d="M244,412 Q228,428 222,448" fill="none" stroke="var(--sc-shirt)" stroke-width="34" stroke-linecap="round" />
                    <path d="M227,437 L221,451" fill="none" stroke="var(--accent)" stroke-width="35" stroke-dasharray="4 20" />
                </g>
                <g class="arm arm-r">
                    <path d="M404,424 Q432,454 426,492" fill="none" stroke="var(--sc-skin)" stroke-width="24" stroke-linecap="round" />
                    <path d="M426,492 L382,452" fill="none" stroke="var(--sc-skin)" stroke-width="20" stroke-linecap="round" />
                    <path d="M396,412 Q412,428 418,448" fill="none" stroke="var(--sc-shirt)" stroke-width="34" stroke-linecap="round" />
                    <path d="M413,437 L419,451" fill="none" stroke="var(--accent)" stroke-width="35" stroke-dasharray="4 20" />
                </g>

                <!-- torso -->
                <g class="torso">
                    <path d="M206,580 C206,478 222,424 264,404 Q320,386 376,404 C418,424 434,478 434,580 Z" fill="var(--sc-shirt)" />
                    <path d="M264,404 Q320,386 376,404" fill="none" stroke="var(--accent)" stroke-width="2" class="rim" />
                    <path d="M294,390 Q320,406 346,390" fill="none" stroke="var(--accent)" stroke-width="5" stroke-linecap="round" />
                    <text x="320" y="446" class="tee-print" text-anchor="middle">{'{ }'}</text>
                    <text x="320" y="458" class="tee-label" text-anchor="middle">FLUXSTACK</text>
                </g>

                <!-- head -->
                <g class="head" data-head>
                    <defs>
                        <clipPath id="sc-hair-clip">
                            <path d={hairPath} />
                        </clipPath>
                    </defs>

                    <rect x="306" y="346" width="28" height="46" rx="10" fill="var(--sc-skin)" />

                    <!-- full beard, seen from behind as it fills out past the jaw -->
                    <path d="M272,318 C266,354 282,382 306,386 L306,356 C295,352 289,340 289,322 Z" fill="var(--sc-hair)" />
                    <path d="M368,318 C374,354 358,382 334,386 L334,356 C345,352 351,340 351,322 Z" fill="var(--sc-hair)" />
                    <g fill="none" stroke="var(--sc-hair-mid)" stroke-width="1.8" stroke-linecap="round">
                        <path d="M278,336 q4,12 12,20 M283,354 q6,10 14,16 M291,344 q3,9 9,15" />
                        <path d="M362,336 q-4,12 -12,20 M357,354 q-6,10 -14,16 M349,344 q-3,9 -9,15" />
                    </g>
                    <path d="M272,318 C266,354 282,382 306,386 M368,318 C374,354 358,382 334,386" fill="none" stroke="var(--accent)" stroke-width="1.5" class="rim" />

                    <!-- wavy curls: dark mass, then flowing strands clipped to it -->
                    <path d={hairPath} fill="var(--sc-hair)" />
                    <g clip-path="url(#sc-hair-clip)" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <g stroke="var(--sc-hair-mid)" stroke-width="10">
                            {strands.map((st) => (
                                <path d={st.d} />
                            ))}
                        </g>
                        <g stroke="var(--sc-hair-hi)" stroke-width="1.8" opacity="0.7">
                            {strands.map((st) => (
                                <path d={st.d} />
                            ))}
                        </g>
                    </g>
                    <!-- screen light along the top of the waves -->
                    <path d={rimPath} fill="none" stroke="var(--accent)" stroke-width="1.6" class="rim" />

                    <!-- headphones, band pressed into the curls -->
                    <path d="M263,324 C252,196 388,196 377,324" fill="none" stroke="var(--sc-phones)" stroke-width="7" stroke-linecap="round" />
                    <rect x="253" y="306" width="19" height="36" rx="7.5" fill="var(--sc-phones)" />
                    <rect x="368" y="306" width="19" height="36" rx="7.5" fill="var(--sc-phones)" />
                    <rect x="256" y="318" width="3" height="12" rx="1.5" fill="var(--accent)" />
                    <rect x="381" y="318" width="3" height="12" rx="1.5" fill="var(--accent)" />
                </g>
            </g>

            <!-- chair back: nearest to us, covers the lower back -->
            <g class="chair">
                <rect x="236" y="468" width="168" height="130" rx="32" fill="var(--sc-chair)" />
                <rect x="252" y="484" width="136" height="100" rx="24" fill="none" stroke="var(--sc-chair-seam)" stroke-width="2" />
                <path d="M262,472 Q320,464 378,472" fill="none" stroke="var(--sc-chair-hi)" stroke-width="2" stroke-linecap="round" />
            </g>
            </g>
        </g>
    </svg>
</div>

<style>
    .scene {
        /* light: daytime room */
        --sc-paper: #fbf8f2;
        --sc-frame: #2f3a4c;
        --sc-sky: #f6dcd7;
        --sc-hill: #5a9e6f;
        --sc-tape: rgba(255, 255, 255, 0.7);
        --sc-wire: #9aa3b2;
        --sc-b1: #f0566a;
        --sc-b2: #ffb454;
        --sc-b3: #5be3b0;
        --sc-b4: #ff9fb2;
        --sc-bulb-o: 0.35;
        --sc-desk-top: #d8c3a5;
        --sc-desk: #cdb593;
        --sc-metal: #8e98a8;
        --sc-monitor: #1d2330;
        --sc-mug: #ffffff;
        --sc-steam: rgba(86, 98, 115, 0.35);
        --sc-leaf: #5a9e6f;
        --sc-leaf-2: #4a8a5e;
        --sc-case: #e6e9ef;
        --sc-shirt: #1d1b1c;
        --sc-skin: #d9a07e;
        --sc-hair: #141010;
        --sc-hair-mid: #221e1d;
        --sc-hair-hi: #4a4340;
        --sc-phones: #eef1f6;
        --sc-chair: #232833;
        --sc-chair-seam: #2f3542;
        --sc-chair-hi: #3a4252;
        --sc-glow-o: 0.28;
        --sc-rim-o: 0.25;
        --sc-lamp-on: 0;

        position: relative;
        width: 100%;
        max-width: 640px;
        margin-inline: auto;
        aspect-ratio: 640 / 560;
    }

    /* Night: lamp on, lights glow, the screen lights the room */
    :global(:root[data-theme='dark']) .scene {
        --sc-paper: #d9d4ca;
        --sc-frame: #0a0e14;
        --sc-sky: #3a2530;
        --sc-hill: #2f5a45;
        --sc-tape: rgba(255, 255, 255, 0.35);
        --sc-wire: #3a4658;
        --sc-bulb-o: 1;
        --sc-desk-top: #3a3128;
        --sc-desk: #2e2620;
        --sc-metal: #4d5666;
        --sc-monitor: #151a24;
        --sc-mug: #cfd6e0;
        --sc-steam: rgba(200, 210, 225, 0.35);
        --sc-leaf: #3f7d55;
        --sc-leaf-2: #356b49;
        --sc-case: #1b222c;
        --sc-shirt: #141213;
        --sc-skin: #a8765c;
        --sc-hair: #0d0a09;
        --sc-hair-mid: #1b1817;
        --sc-hair-hi: #3a3432;
        --sc-phones: #cfd6e0;
        --sc-chair: #10141b;
        --sc-chair-seam: #1b212b;
        --sc-chair-hi: #262d39;
        --sc-glow-o: 0.7;
        --sc-rim-o: 0.75;
        --sc-lamp-on: 1;
    }

    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme='light'])) .scene {
            --sc-paper: #d9d4ca;
            --sc-frame: #0a0e14;
            --sc-sky: #3a2530;
            --sc-hill: #2f5a45;
            --sc-tape: rgba(255, 255, 255, 0.35);
            --sc-wire: #3a4658;
            --sc-bulb-o: 1;
            --sc-desk-top: #3a3128;
            --sc-desk: #2e2620;
            --sc-metal: #4d5666;
            --sc-monitor: #151a24;
            --sc-mug: #cfd6e0;
            --sc-steam: rgba(200, 210, 225, 0.35);
            --sc-leaf: #3f7d55;
            --sc-leaf-2: #356b49;
            --sc-case: #1b222c;
            --sc-shirt: #141213;
            --sc-skin: #a8765c;
            --sc-hair: #0d0a09;
            --sc-hair-mid: #1b1817;
            --sc-hair-hi: #3a3432;
            --sc-phones: #cfd6e0;
            --sc-chair: #10141b;
            --sc-chair-seam: #1b212b;
            --sc-chair-hi: #262d39;
            --sc-glow-o: 0.7;
            --sc-rim-o: 0.75;
            --sc-lamp-on: 1;
        }
    }

    /* A soft pool of page colour behind the scene so the hero's contour
       lines fade out instead of running through the room */
    .scene::before {
        content: '';
        position: absolute;
        inset: -12% -10% -4%;
